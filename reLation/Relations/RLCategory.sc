// reLation — a category generated by named arrows: everything their compositions give, each with a shortest
// word.
//
// The generators are RLRelations or RLTransforms (anything that composes with <>, compares by value and
// answers sourceIdentity, targetIdentity and follows). Arrows on one list of objects generate a monoid; when
// every arrow can be undone, a group. Arrows between several lists generate a category with as many objects.
//
//   ~cd = RLRelationContext.cubeDance;                // 24 triads and 4 augmented triads; U, P, L
//   ~m = ~cd.category;                                // RLCategory([[\U, u], [\P, p], [\L, l]])
//   ~m.size;                                          // 40
//   ~m.wordOf(~m.generator(\L) <> ~m.generator(\P));  // [P, L]: words are in the order of time
//   ~m.arrow([\U, \U, \U]) == ~m.generator(\U);       // true: U three times is U
//   ~m.invertibles.size;                              // 6: the identity, P, L and their products
//
// The closure is guarded: more than maxSize arrows is an Error (a monoid of relations can be very large).

RLCategory {
	var <names, generators, <arrows, words, index, <identities, steps;

	*new { |generators, maxSize = 4000| ^super.new.prInit(generators, maxSize) }

	prInit { |gens, maxSize|
		var frontier;
		names = Array.new;
		generators = IdentityDictionary.new;
		gens.do { |g|
			var name, arrow;
			#name, arrow = if(g.isKindOf(Association)) { [g.key, g.value] } { g };
			names = names.add(name.asSymbol);
			generators[name.asSymbol] = arrow;
		};
		arrows = Array.new;
		words = Array.new;
		steps = Array.new;
		index = Dictionary.new;
		identities = Array.new;
		names.do { |n|
			[generators[n].sourceIdentity, generators[n].targetIdentity].do { |id|
				if(index[id].isNil) { this.prAdd(id, []); identities = identities.add(id) };
			};
		};
		frontier = Array.series(arrows.size);
		while { frontier.notEmpty } {
			var next = Array.new;
			frontier.do { |i|
				names.do { |n, k|
					var g = generators[n], x = arrows[i], y, j;
					if(g.follows(x)) {
						y = g <> x;
						j = index[y];
						if(j.isNil) {
							if(arrows.size >= maxSize) {
								Error("RLCategory: more than % arrows; raise maxSize if that is meant".format(maxSize)).throw
							};
							j = this.prAdd(y, words[i] ++ [n]);
							next = next.add(j);
						};
						steps[i][k] = j;
					};
				};
			};
			frontier = next;
		};
	}

	prAdd { |arrow, word|
		var i = arrows.size;
		arrow.label = if(word.isEmpty) { "id" } { word.reverse.join };
		arrows = arrows.add(arrow);
		words = words.add(word);
		steps = steps.add(Array.newClear(names.size));
		index[arrow] = i;
		^i
	}

	size { ^arrows.size }
	generator { |name| ^generators[name.asSymbol] ?? { Error("RLCategory: no generator named %".format(name)).throw } }
	includes { |arrow| ^index[arrow].notNil }
	indexOf { |arrow| ^index[arrow] }

	// The shortest word of an arrow, its steps in the order of time; nil when it is not one of the arrows.
	wordOf { |arrow| ^index[arrow] !? { |i| words[i].copy } }
	words { ^words.collect(_.copy) }

	// The arrow of a word (steps in the order of time).
	arrow { |word|
		var w = word.asArray.collect(_.asSymbol), i;
		if(w.isEmpty) {
			if(identities.size != 1) { Error("RLCategory: the empty word names % identities".format(identities.size)).throw };
			^identities[0]
		};
		i = index[this.generator(w[0]).sourceIdentity];
		w.do { |n|
			i = i !? { steps[i][names.indexOf(n) ?? { Error("RLCategory: no generator named %".format(n)).throw }] };
		};
		^i !? { arrows[i] } ?? { Error("RLCategory: the steps of % do not follow one another".format(w)).throw }
	}

	// The index of arrows[i] after arrows[j]; nil when they do not follow one another.
	composeIndex { |i, j|
		var k = j;
		if(arrows[i].follows(arrows[j]).not) { ^nil };
		words[i].do { |n| k = steps[k][names.indexOf(n)] };
		^k
	}

	// The whole table: table[i][j] is the index of arrows[i] after arrows[j].
	table { ^Array.fill(arrows.size) { |i| Array.fill(arrows.size) { |j| this.composeIndex(i, j) } } }

	isMonoid { ^identities.size == 1 }

	// The arrows that can be undone, and whether all can.
	invertibles {
		var ids = identities.collect { |x| index[x] };
		^arrows.select { |a, i|
			arrows.any { |b, j|
				var ab = this.composeIndex(i, j), ba = this.composeIndex(j, i);
				ab.notNil and: { ba.notNil } and: { ids.includes(ab) } and: { ids.includes(ba) }
			}
		}
	}
	isGroup { ^this.isMonoid and: { this.invertibles.size == arrows.size } }

	// The arrows that take x to y (for relations: that relate them).
	relating { |x, y| ^arrows.select { |a| a.relates(x, y) } }

	// The category's own instance of an arrow (the one that carries its word as label), or nil.
	canonical { |arrow| ^index[arrow] !? { |i| arrows[i] } }

	// Where the powers of arrows[i] come back: [m, period], the first m with a^m = a^(m + period).
	prPowerType { |i|
		var seen = [i], k = i, at;
		while {
			k = this.composeIndex(i, k);
			at = seen.indexOf(k);
			at.isNil
		} { seen = seen.add(k) };
		^[at + 1, seen.size - at]
	}

	// The automorphisms of a monoid: the ways of sending each arrow to an arrow, one to one, that keep
	// composition. Each is an Array of indices: arrows[i] goes to arrows[result[i]]. Found by trying, for each
	// generator, the arrows that behave as it does (undone or not, the same return of their powers).
	automorphisms {
		var id, inv, types, gens, cands, out = Array.new, n = arrows.size, try;
		if(this.isMonoid.not) { Error("RLCategory: automorphisms are searched for a monoid (one list of objects)").throw };
		id = index[identities[0]];
		inv = this.invertibles.collect { |a| index[a] };
		types = Array.fill(n) { |i| this.prPowerType(i) };
		gens = names.collect { |name| index[this.arrow([name])] };
		cands = gens.collect { |g|
			(0..(n - 1)).select { |c| (types[c] == types[g]) and: { inv.includes(c) == inv.includes(g) } }
		};
		try = { |chosen|
			var img, ok = true;
			if(chosen.size < gens.size) {
				cands[chosen.size].do { |c| try.value(chosen ++ [c]) };
			} {
				img = Array.fill(n) { |j|
					var k = id;
					words[j].do { |name| k = this.composeIndex(chosen[names.indexOf(name)], k) };
					k
				};
				if(img.asSet.size != n) { ok = false };
				if(ok) {
					n.do { |j|
						names.size.do { |g|
							if(ok and: { img[steps[j][g]] != this.composeIndex(chosen[g], img[j]) }) { ok = false };
						};
					};
				};
				if(ok) { out = out.add(img) };
			};
		};
		try.value([]);
		^out
	}

	// From where the generators go (the index of each one's image, in the order of names), where every arrow
	// goes, along its word. Nothing is checked.
	extendMap { |generatorImages|
		var id = index[identities[0]];
		^Array.fill(arrows.size) { |j|
			var k = id;
			words[j].do { |name| k = this.composeIndex(generatorImages[names.indexOf(name)], k) };
			k
		}
	}

	// The image of an arrow under one of them.
	imageOf { |automorphism, arrow|
		var i = index[arrow] ?? { Error("RLCategory: % is not one of the arrows".format(arrow)).throw };
		^arrows[automorphism[i]]
	}

	printOn { |stream| stream << "RLCategory(" << names << ": " << arrows.size << " arrows)" }
}
